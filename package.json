{
  "name": "findjob",
  "version": "0.1.0",
  "private": true,
  "description": "Personal job-search automation toolkit",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fetch": "tsx scripts/run-fetch.ts",
    "score": "tsx scripts/run-score.ts",
    "report": "npm run fetch && npm run score",
    "build:cv": "tsx scripts/build-cv.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint scripts/**/*.ts",
    "lint:fix": "eslint scripts/**/*.ts --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "dotenv": "^16.4.5",
    "md-to-pdf": "^5.2.4",
    "openai": "^4.67.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.0",
    "eslint": "^10.4.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "prettier": "3.8.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.59.3"
  }
}
